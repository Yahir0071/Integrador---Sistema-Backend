<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.utp.Grupo06.view.VentasPosViewController"
      spacing="16" alignment="TOP_LEFT" maxWidth="Infinity" maxHeight="Infinity">

    <!-- Panel Izquierdo: Catálogo y Búsqueda de Productos para la Venta -->
    <VBox spacing="12" HBox.hgrow="ALWAYS" minWidth="0">
        <VBox spacing="2">
            <Label text="Punto de Venta (Caja / Facturación)" styleClass="main-title" wrapText="true"/>
            <Label text="Seleccione los productos para añadir al ticket de venta" styleClass="sub-title" wrapText="true"/>
        </VBox>

        <!-- Buscador y Selector de Cantidad -->
        <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
            <TextField fx:id="txtBuscarProducto" promptText="🔍 Buscar por nombre, código o marca..."
                       prefWidth="220" prefHeight="36"
                       style="-fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;"/>

            <Label text="Cant:" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <Spinner fx:id="spnCantidad" prefWidth="75" prefHeight="36" editable="true"/>

            <Button text="➕ Añadir al Carrito" onAction="#handleAnadirAlCarrito" minWidth="-Infinity"
                    styleClass="btn, btn-primary" style="-fx-font-weight: bold; -fx-cursor: hand;"/>
        </FlowPane>

        <!-- Tabla de Productos Disponibles -->
        <TableView fx:id="tblCatalogo" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colCatCodigo" text="Código" prefWidth="80"/>
                <TableColumn fx:id="colCatNombre" text="Producto" prefWidth="170"/>
                <TableColumn fx:id="colCatMarca" text="Marca" prefWidth="80"/>
                <TableColumn fx:id="colCatPrecio" text="Precio (S/)" prefWidth="75"/>
                <TableColumn fx:id="colCatStock" text="Stock Disp." prefWidth="75"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- Panel Derecho: Carrito de Compras y Métodos de Pago (ScrollPane para 1180x720) -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                prefWidth="390" minWidth="350" maxWidth="410"
                style="-fx-background-color: transparent;">
        <VBox spacing="12" styleClass="card-box">

            <Label text="Detalle de la Venta" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Separator/>

            <!-- Tabla del Carrito -->
            <TableView fx:id="tblCarrito" prefHeight="185" minHeight="140" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colCarProducto" text="Item" prefWidth="145"/>
                    <TableColumn fx:id="colCarCant" text="Cant." prefWidth="50"/>
                    <TableColumn fx:id="colCarPrecio" text="P. Unit" prefWidth="65"/>
                    <TableColumn fx:id="colCarSubtotal" text="Subtotal" prefWidth="75"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Desglose de Totales y Tributario (IGV 18%) -->
            <VBox spacing="4" alignment="CENTER_RIGHT" style="-fx-padding: 2px 0;">
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Label text="Op. Gravada (Subtotal):" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                    <Label fx:id="lblSubtotalVenta" text="S/ 0.00" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;"/>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Label text="I.G.V. (18%):" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                    <Label fx:id="lblIgvVenta" text="S/ 0.00" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;"/>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 4px 0 0 0;">
                    <Label text="TOTAL A PAGAR:" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label fx:id="lblTotalVenta" text="S/ 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
                </HBox>
            </VBox>

            <Separator/>

            <!-- Desglose de Pagos Mixtos (Efectivo / Yape / Plin) -->
            <VBox spacing="6">
                <Label text="Métodos de Pago:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Efectivo (S/):" prefWidth="100"/>
                    <TextField fx:id="txtMontoEfectivo" text="0.00" prefHeight="30" HBox.hgrow="ALWAYS"
                               style="-fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Yape (S/):" prefWidth="100"/>
                    <TextField fx:id="txtMontoYape" text="0.00" prefHeight="30" HBox.hgrow="ALWAYS"
                               style="-fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Plin (S/):" prefWidth="100"/>
                    <TextField fx:id="txtMontoPlin" text="0.00" prefHeight="30" HBox.hgrow="ALWAYS"
                               style="-fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;"/>
                </HBox>
            </VBox>

            <!-- Botones de Acción -->
            <VBox spacing="8">
                <Button text="Procesar y Emitir Ticket" onAction="#handleEmitirVenta" prefHeight="42" maxWidth="Infinity"
                        styleClass="btn, btn-success" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6px;"/>

                <Button text="Limpiar Carrito" onAction="#handleLimpiarCarrito" maxWidth="Infinity"
                        styleClass="btn, btn-default" style="-fx-cursor: hand; -fx-background-radius: 6px;"/>
            </VBox>

        </VBox>
    </ScrollPane>

</HBox>
