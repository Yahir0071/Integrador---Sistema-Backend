<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.utp.Grupo06.view.VentasPosViewController"
      spacing="20" alignment="TOP_LEFT" maxWidth="Infinity" maxHeight="Infinity">

    <!-- Panel Izquierdo: Catálogo y Búsqueda de Productos para la Venta -->
    <VBox spacing="14" HBox.hgrow="ALWAYS">
        <VBox spacing="2">
            <Label text="Punto de Venta (Caja / Facturación)" styleClass="main-title"/>
            <Label text="Seleccione los productos para añadir al ticket de venta" styleClass="sub-title"/>
        </VBox>

        <!-- Buscador y Selector de Cantidad -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtBuscarProducto" promptText="🔍 Buscar por nombre o código..." prefHeight="38" HBox.hgrow="ALWAYS"
                       style="-fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;"/>
            
            <Label text="Cant:" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <Spinner fx:id="spnCantidad" prefWidth="80" prefHeight="38" editable="true"/>

            <Button text="➕ Añadir al Carrito" onAction="#handleAnadirAlCarrito"
                    styleClass="btn, btn-primary" style="-fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>

        <!-- Tabla de Productos Disponibles -->
        <TableView fx:id="tblCatalogo" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colCatCodigo" text="Código" prefWidth="100"/>
                <TableColumn fx:id="colCatNombre" text="Producto" prefWidth="200"/>
                <TableColumn fx:id="colCatPrecio" text="Precio (S/)" prefWidth="90"/>
                <TableColumn fx:id="colCatStock" text="Stock Disp." prefWidth="90"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- Panel Derecho: Carrito de Compras y Métodos de Pago -->
    <VBox spacing="14" prefWidth="420" styleClass="card-box">
        
        <Label text="🧾 Detalle de la Venta" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        <Separator/>

        <!-- Tabla del Carrito -->
        <TableView fx:id="tblCarrito" prefHeight="220" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colCarProducto" text="Item" prefWidth="160"/>
                <TableColumn fx:id="colCarCant" text="Cant." prefWidth="60"/>
                <TableColumn fx:id="colCarPrecio" text="P. Unit" prefWidth="70"/>
                <TableColumn fx:id="colCarSubtotal" text="Subtotal" prefWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Total de la Venta -->
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 8px 0;">
            <Label text="TOTAL A PAGAR:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <Label fx:id="lblTotalVenta" text="S/ 0.00" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
        </HBox>

        <Separator/>

        <!-- Desglose de Pagos Mixtos (Efectivo / Yape / Plin) -->
        <VBox spacing="8">
            <Label text="Métodos de Pago:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;"/>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="💵 Efectivo (S/):" prefWidth="110"/>
                <TextField fx:id="txtMontoEfectivo" text="0.00" prefHeight="32" HBox.hgrow="ALWAYS"
                           style="-fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="📱 Yape (S/):" prefWidth="110"/>
                <TextField fx:id="txtMontoYape" text="0.00" prefHeight="32" HBox.hgrow="ALWAYS"
                           style="-fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="💳 Plin (S/):" prefWidth="110"/>
                <TextField fx:id="txtMontoPlin" text="0.00" prefHeight="32" HBox.hgrow="ALWAYS"
                           style="-fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Botones de Acción -->
        <VBox spacing="8">
            <Button text="💳 Procesar y Emitir Ticket" onAction="#handleEmitirVenta" prefHeight="45" maxWidth="Infinity"
                    styleClass="btn, btn-success" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6px;"/>

            <Button text="🗑️ Limpiar Carrito" onAction="#handleLimpiarCarrito" maxWidth="Infinity"
                    styleClass="btn, btn-default" style="-fx-cursor: hand; -fx-background-radius: 6px;"/>
        </VBox>

    </VBox>

</HBox>
