# Ejemplo de configuración local privada (copiar a .env o application-local.properties)
# NO subir credenciales reales a Git ni incluirlas en entregas académicas.

DB_URL=jdbc:postgresql://localhost:5432/comercial_nova
DB_USERNAME=postgres
DB_PASSWORD=REEMPLAZAR_POR_CONTRASENA_REAL

# Clave JWT persistente (Base64 de al menos 32 bytes; ej: openssl rand -base64 32)
JWT_SECRET=REEMPLAZAR_POR_CLAVE_BASE64_DE_32_BYTES

# Orígenes permitidos para el frontend E-Commerce
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
