# Conexión a PostgreSQL / Supabase
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.qoupwzmfmsxtjasackkf
DB_PASSWORD=REEMPLAZAR_POR_CONTRASENA_REAL

# Secreto JWT en Base64 (mínimo 32 bytes codificados; ej: openssl rand -base64 48)
JWT_SECRET=REEMPLAZAR_POR_CLAVE_BASE64_DE_32_BYTES

# Orígenes CORS del frontend (separados por comas)
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Tienda web – modo demostración
TIENDA_DEMO=true
TIENDA_TITULAR=Comercial Nova - DEMOSTRACION
TIENDA_YAPE=DEMO - no transferir
