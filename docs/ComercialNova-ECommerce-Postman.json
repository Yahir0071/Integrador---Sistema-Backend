{
  "info": {
    "name": "Comercial Nova - Pruebas E-Commerce API",
    "description": "Colección automatizada para validar catálogo, registro, login, perfil, seguridad RBAC y pedidos del E-Commerce Comercial Nova.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "testUsername", "value": "" },
    { "key": "testEmail", "value": "" },
    { "key": "clientToken", "value": "" },
    { "key": "productoId", "value": "" },
    { "key": "productoPrecio", "value": "" }
  ],
  "item": [
    {
      "name": "1. Info de Tienda (Público)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tienda"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve titular y horario', () => {",
              "  const j = pm.response.json();",
              "  pm.expect(j).to.have.property('titular');",
              "  pm.expect(j).to.have.property('horario');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Catálogo Público de Productos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/catalogo/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "const list = pm.response.json();",
              "pm.test('Catálogo no vacío', () => pm.expect(list.length).to.be.above(0));",
              "pm.test('No expone precioCompra interno', () => pm.expect(pm.response.text()).to.not.include('precioCompra'));",
              "const disponible = list.find(p => p.disponible > 0) || list[0];",
              "if (disponible) {",
              "  pm.collectionVariables.set('productoId', disponible.id);",
              "  pm.collectionVariables.set('productoPrecio', disponible.precioVenta);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Seguridad - Pedidos sin Token (401)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/pedidos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rechaza acceso sin token con 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Validación - Registro con Teléfono Inválido (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/registro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"cli_invalido\",\n  \"password\": \"ClaveSegura2026!\",\n  \"nombreCompleto\": \"Cliente Prueba\",\n  \"email\": \"invalido@test.com\",\n  \"telefono\": \"--------\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rechaza teléfono sin dígitos con 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Registro de Cliente Nuevo (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ts = Date.now();",
              "pm.collectionVariables.set('testUsername', 'cli_pm_' + ts);",
              "pm.collectionVariables.set('testEmail', 'cli_pm_' + ts + '@test.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cliente creado con 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Devuelve accessToken y rol CLIENTE', () => {",
              "  pm.expect(j.accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(j.rol).to.eql('CLIENTE');",
              "});",
              "pm.collectionVariables.set('clientToken', j.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/registro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"ClaveSegura2026!\",\n  \"nombreCompleto\": \"Cliente Postman\",\n  \"email\": \"{{testEmail}}\",\n  \"telefono\": \"987654321\"\n}"
        }
      }
    },
    {
      "name": "6. Login de Cliente (200)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"ClaveSegura2026!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.collectionVariables.set('clientToken', j.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Perfil del Cliente (/api/auth/me)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Usuario coincide', () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get('testUsername')));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Seguridad RBAC - Cliente bloqueado en /api/usuarios (403)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
        "url": "{{baseUrl}}/api/usuarios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cliente no accede a rutas internas (403)', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Crear Pedido Web (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('pedidoClave', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Pedido creado con 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Estado inicial PENDIENTE_PAGO', () => pm.expect(j.estado).to.eql('PENDIENTE_PAGO'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{clientToken}}" }
        ],
        "url": "{{baseUrl}}/api/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clave\": \"{{pedidoClave}}\",\n  \"items\": [\n    {\n      \"productoId\": {{productoId}},\n      \"cantidad\": 1,\n      \"precioEsperado\": {{productoPrecio}}\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "10. Listar Mis Pedidos (200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
        "url": "{{baseUrl}}/api/pedidos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve al menos 1 pedido', () => pm.expect(pm.response.json().length).to.be.above(0));"
            ]
          }
        }
      ]
    }
  ]
}
